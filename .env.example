# =============================================================
# Café Brume — Variables d'environnement
# Copiez ce fichier en `.env.local` et remplissez les valeurs.
# TOUTES les intégrations sont "env-gated" : sans les variables, la
# fonctionnalité se désactive proprement (l'app démarre quand même).
# Ne committez JAMAIS de secrets réels.
# =============================================================

# ---- Application ----
# URL publique de base (sert aux liens de suivi, emails, webServiceURL Wallet).
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# ---- Supabase (REQUIS) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # clé anon (publique)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # clé service role (SERVEUR UNIQUEMENT)

# ---- Stripe (paiement TWINT + carte) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...                 # secret du endpoint webhook
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- Resend (emails transactionnels) ----
RESEND_API_KEY=re_...
EMAIL_FROM="Café Brume <commandes@brume.click>"

# ---- Apple Wallet (.pkpass signé + APNs) ----
# Certificat Pass Type ID (PEM) + clé privée (PEM, éventuellement chiffrée).
APPLE_WALLET_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
APPLE_WALLET_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
APPLE_WALLET_KEY_PASSWORD=                       # mot de passe de la clé (si chiffrée)
APPLE_WWDR_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"  # intermédiaire WWDR
APPLE_PASS_TYPE_ID=pass.click.brume.loyalty
APPLE_TEAM_ID=ABCDE12345
# APNs (push de mise à jour du pass) — clé .p8 au format PEM.
APPLE_APNS_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_APNS_KEY_ID=XYZ1234567

# ---- Google Wallet (API Loyalty) ----
GOOGLE_WALLET_ISSUER_ID=3388000000000000000
# JSON complet du compte de service (sur une seule ligne, guillemets échappés).
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"}
GOOGLE_WALLET_CLASS_SUFFIX=cafe_loyalty

# ---- Cron (expiration mensuelle des points, fallback Vercel Cron) ----
CRON_SECRET=change-me-long-random

# ---- Monitoring ----
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
