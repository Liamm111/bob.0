{
  "name": "cafe-brume",
  "version": "1.0.0",
  "private": true,
  "description": "Café Brume — Click & Collect + Fidélité (multi-café)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:types": "supabase gen types typescript --local > src/types/supabase.ts",
    "db:reset": "supabase db reset",
    "email:dev": "email dev --dir src/lib/email/templates"
  },
  "dependencies": {
    "@react-email/components": "^0.0.31",
    "@sentry/nextjs": "^8.47.0",
    "@stripe/react-stripe-js": "^3.10.0",
    "@stripe/stripe-js": "^5.10.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "googleapis": "^144.0.0",
    "libphonenumber-js": "^1.11.17",
    "next": "15.1.3",
    "node-forge": "^1.3.1",
    "posthog-js": "^1.203.1",
    "posthog-node": "^4.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.1",
    "server-only": "^0.0.1",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/node-forge": "^1.3.11",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.3",
    "react-email": "^3.0.4",
    "supabase": "^2.2.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.33.0"
}
